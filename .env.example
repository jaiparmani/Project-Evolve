# LLM Provider: "gateway" (recommended) or "openrouter" (direct)
LLM_PROVIDER=gateway

# LLM Gateway (https://github.com/jaiparmani/llm-gateway)
LLM_GATEWAY_URL=https://llm-gateway.brain-store.workers.dev
LLM_GATEWAY_TOKEN=your-client-token-here

# Direct OpenRouter (fallback if gateway unavailable)
OPENROUTER_API_KEY=

# Model override (leave empty for gateway's auto-routing)
LLM_MODEL=

# Database
DATABASE_URL=sqlite://./data/evolve.db

# Git configuration
EVOLVE_BRANCH=evolve/auto
GITHUB_REMOTE=origin

# Evolution settings
EVOLVE_INTERVAL_MINUTES=30
EVOLVE_MAX_CYCLES_PER_DAY=48
EVOLVE_MAX_REQUESTS_PER_CYCLE=20
EVOLVE_MAX_TOKENS_PER_CYCLE=50000
EVOLVE_DAILY_BUDGET_USD=0.00

# Control Room Server
PORT=3000
NODE_ENV=development

# Application being evolved (path to the app source)
EVOLVE_APP_DIR=./evolving-app

# Deployment
DEPLOY_STRATEGY=local
DEPLOY_PORT=3001
DEPLOY_HEALTH_URL=http://localhost:3001/health
